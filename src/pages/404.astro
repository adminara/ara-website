---
import Base from '../layouts/Base.astro';
import { company } from '../data/site';
---

<Base title={`Halaman tidak ditemukan — ${company.name}`} description="Halaman yang dicari tidak ditemukan." indexable={false}>
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow">Error 404</p>
      <h1>Halaman tidak ditemukan</h1>
      <span class="rule" aria-hidden="true"></span>
      <p class="lead">Alamat yang Anda buka tidak tersedia.</p>
      <p class="hero__actions"><a class="btn btn--primary" href="/">Kembali ke beranda</a></p>
    </div>
  </section>
</Base>
