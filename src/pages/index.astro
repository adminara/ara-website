---
import Base from '../layouts/Base.astro';
import {
  businesses,
  company,
  founders,
  httpsUrl,
  initials,
  waUrl,
} from '../data/site';

const site = Astro.site;
const displayHost = (href: string) => {
  try {
    const host = new URL(href).hostname;
    return host.startsWith('www.') ? host : `www.${host}`;
  } catch {
    return href;
  }
};
const jsonLd = site && {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': new URL('/#organization', site).href,
  name: company.name,
  url: new URL('/', site).href,
  telephone: `+${company.whatsapp.number}`,
  ...(founders.length > 0 && {
    founder: founders.map((f) => ({ '@type': 'Person', name: f.name })),
  }),
};
---

<Base title={company.title} description={company.description} jsonLd={jsonLd || undefined}>
  <section class="hero" aria-labelledby="judul">
    <div class="container hero__grid">
      <div>
        <p class="eyebrow">Perusahaan payung</p>
        <h1 id="judul">{company.name}</h1>
        <span class="rule" aria-hidden="true"></span>
        <p class="lead">{company.intro}</p>
      </div>
      <div class="hero__art" aria-hidden="true">
        <img src="/logo/ARA_Monogram.svg" width="400" height="350" alt="" fetchpriority="high" />
      </div>
    </div>
  </section>

  <section id="tentang" class="section" aria-labelledby="tentang-judul">
    <div class="container split">
      <div>
        <p class="eyebrow">Profil</p>
        <h2 id="tentang-judul">Tentang Perusahaan</h2>
      </div>
      <div class="prose">
        {company.about.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section id="lini-usaha" class="section section--band" aria-labelledby="lini-judul">
    <div class="container">
      <p class="eyebrow">Direktori</p>
      <h2 id="lini-judul">Lini Usaha</h2>
      <p class="section__intro">
        Ringkasan lini usaha yang dinaungi. Detail program dan layanan tersedia di website resmi masing-masing.
      </p>

      <ul class="grid" role="list">
        {
          businesses.map((b) => {
            const url = httpsUrl(b.url);
            return (
              <li class="card business">
                <div class="business__mark" aria-hidden="true">
                  {b.logo ? (
                    <img src={b.logo.src} width={b.logo.width} height={b.logo.height} alt="" loading="lazy" />
                  ) : (
                    <span>{initials(b.name)}</span>
                  )}
                </div>
                <h3>
                  {url ? (
                    <a class="business__title-link" href={url}>
                      <span>{b.name}</span>
                      <svg class="business__url-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                        <polyline points="15 3 21 3 21 9"></polyline>
                        <line x1="10" y1="14" x2="21" y2="3"></line>
                      </svg>
                    </a>
                  ) : (
                    b.name
                  )}
                </h3>
                <p class="business__field">{b.field}</p>
                <p>{b.summary}</p>
                <p class="business__link">
                  {url ? (
                    <a href={url}>{displayHost(url)}</a>
                  ) : (
                    <span class="muted">Website belum tersedia</span>
                  )}
                </p>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <section id="pendiri" class="section" aria-labelledby="pendiri-judul">
    <div class="container">
      <p class="eyebrow">Di balik perusahaan</p>
      <h2 id="pendiri-judul">Profil Pendiri</h2>

      {
        founders.length > 0 ? (
          <ul class="founders-list" role="list">
            {founders.map((f) => (
              <li class="card founder">
                {f.photo ? (
                  <img
                    class="founder__photo"
                    src={f.photo.src}
                    width={f.photo.width}
                    height={f.photo.height}
                    alt={f.photo.alt}
                    loading="lazy"
                  />
                ) : (
                  <div class="founder__avatar" aria-hidden="true">
                    <span>{initials(f.name)}</span>
                  </div>
                )}
                <div>
                  <h3>{f.name}</h3>
                  <p class="business__field">{f.role}</p>
                  <p style="white-space: pre-line;">{f.bio}</p>
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <div class="card card--pending">
            <p class="badge">Konten belum lengkap</p>
            <p>Nama, peran, dan bio pendiri akan ditampilkan setelah diverifikasi dan disetujui untuk publikasi.</p>
          </div>
        )
      }
    </div>
  </section>
  <section id="kontak-bisnis" class="section section--band" aria-labelledby="bisnis-judul">
    <div class="container split">
      <div>
        <p class="eyebrow">Kemitraan</p>
        <h2 id="bisnis-judul">Kontak Bisnis</h2>
      </div>
      <div class="prose">
        <p>Untuk penjajakan kerja sama atau kemitraan, hubungi tim bisnis kami melalui email atau WhatsApp.</p>
        <div class="contact-links">
          <a class="contact-link" href={`mailto:${company.contact.business}`} aria-label={`Email: ${company.contact.business}`}>
            <svg class="contact-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            <span>{company.contact.business}</span>
          </a>
          <a class="contact-link" href={waUrl(company.whatsapp.number, company.whatsapp.businessText)} aria-label={`WhatsApp: ${company.whatsapp.label}`}>
            <svg class="contact-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm0 18.15c-1.49 0-2.95-.4-4.22-1.15l-.3-.18-3.13.82.83-3.05-.2-.31a8.13 8.13 0 0 1-1.25-4.37c0-4.51 3.67-8.18 8.18-8.18 2.19 0 4.24.85 5.78 2.39 1.55 1.55 2.4 3.6 2.4 5.79 0 4.51-3.67 8.18-8.18 8.18zm4.49-6.13c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43s-.56-1.35-.77-1.85c-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.84-.86 2.05 0 1.21.88 2.38 1 2.55.13.17 1.74 2.65 4.21 3.72.59.25 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.07-.1-.23-.17-.47-.29z"></path>
            </svg>
            <span>{company.whatsapp.label}</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
